# ============================================================
#  MySQL 8.0 容器配置
#  挂载到 /etc/mysql/conf.d/，会被主配置 include
#  注意：lower_case_table_names 只在初始化时生效，改它必须重建数据卷
# ============================================================

[mysqld]
# ---------- 字符集：中文、emoji、生僻字全部覆盖 ----------
character-set-server         = utf8mb4
collation-server             = utf8mb4_0900_ai_ci
skip-character-set-client-handshake

# ---------- 表名大小写 ----------
# 1 = 不区分大小写（跟 Windows 上的习惯一致）
# 这一条是给六个人用的：有人写 Sku、有人写 sku，不统一到这里迟早出事
lower_case_table_names       = 1

# ---------- 时间 ----------
default-time-zone            = '+08:00'

# ---------- 连接数 ----------
# 六个人同时开着 IDE 调试，默认 151 不够
max_connections              = 300
max_connect_errors           = 1000
wait_timeout                 = 28800
interactive_timeout          = 28800

# ---------- InnoDB ----------
# 演示机器内存有限，512M 缓冲池够用；线上要按内存调
innodb_buffer_pool_size      = 512M
innodb_log_file_size         = 128M
innodb_flush_log_at_trx_commit = 1
innodb_lock_wait_timeout     = 10

# ---------- SQL 模式：严格，不静默截断 ----------
# 金额算错、超长字符串被截断这类问题，必须在报错时就暴露，不能让它悄悄写进去
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# ---------- 慢查询 ----------
# 超过 1 秒记下来，报表接口慢了能马上看见
slow_query_log               = 1
slow_query_log_file          = /var/lib/mysql/slow.log
long_query_time              = 1
log_queries_not_using_indexes = 0

# ---------- 日志 ----------
log_error_verbosity          = 2

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
