# ============================================================
#  环境变量模板 —— 复制成 .env 后按需修改
#      cp .env.example .env
#  .env 已被 .gitignore 排除，不会进仓库；密码不要提交。
# ============================================================

# ---------- MySQL ----------
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root_Local_2026
MYSQL_DATABASE=pos
MYSQL_USER=pos
MYSQL_PASSWORD=pos_Local_2026

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_PASSWORD=redis_Local_2026

# ---------- 应用端口 ----------
# 后端容器映射到宿主机的端口（本地直接用 IDE 跑时不冲突）
BACKEND_PORT=8080
# 前端网关端口。用 8088 而不是 80：80 常被占，Linux 上还需要 root
GATEWAY_PORT=8088
# Adminer 数据库网页客户端
ADMINER_PORT=8081

# ---------- 时区 ----------
TZ=Asia/Shanghai
